# 이 파일을 복사해서 .env 를 만들고 값을 채우세요. (.env 는 커밋하지 않습니다)
# cp .env.example .env

# 프로젝트에서 쓰는 외부 API 키를 아래에 추가하세요. (값은 비워 둔 채로 커밋)
# EXAMPLE_API_KEY=

# LLM
OPENAI_API_KEY=
OLLAMA_BASE_URL=

# Discord 웹훅은 코드에서 쓸 때만 필요합니다. 주소를 아는 사람은 누구나 채널에 글을 올릴 수 있으니 공유 주의!
DISCORD_WEBHOOK_URL=


# 실험 기록용 구글 시트
# 값은 팀 채팅에서 전달받아 .env 에만 넣습니다. 주소와 비밀키는 팀원 모두 같습니다.
# 주소 형식: https://script.google.com/macros/s/<배포ID>/exec
SHEET_WEBHOOK_URL=
SHEET_SECRET=
# 시트의 author 열에 기록될 내 이름 (팀원마다 다름)
EXPERIMENT_AUTHOR=
